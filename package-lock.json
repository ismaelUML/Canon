{
  "name": "canon-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "canon-workspace",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@canon/application": {
      "resolved": "packages/canon_application",
      "link": true
    },
    "node_modules/@canon/domain": {
      "resolved": "packages/canon_domain",
      "link": true
    },
    "node_modules/@canon/infrastructure": {
      "resolved": "packages/canon_infrastructure",
      "link": true
    },
    "node_modules/@canon/presentation": {
      "resolved": "packages/canon_presentation",
      "link": true
    },
    "packages/canon_application": {
      "name": "@canon/application",
      "version": "0.1.0",
      "dependencies": {
        "@canon/domain": "file:../canon_domain"
      }
    },
    "packages/canon_domain": {
      "name": "@canon/domain",
      "version": "0.1.0"
    },
    "packages/canon_infrastructure": {
      "name": "@canon/infrastructure",
      "version": "0.1.0",
      "dependencies": {
        "@canon/application": "file:../canon_application",
        "@canon/domain": "file:../canon_domain"
      }
    },
    "packages/canon_presentation": {
      "name": "@canon/presentation",
      "version": "0.1.0",
      "dependencies": {
        "@canon/application": "file:../canon_application",
        "@canon/domain": "file:../canon_domain",
        "@canon/infrastructure": "file:../canon_infrastructure"
      }
    }
  }
}
